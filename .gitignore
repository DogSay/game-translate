*.pak
*.utoc
*.ucas
*.locres
*.uasset
*.uexp
*.assets
*.exe
*.dll
*.pdb

# Synthetic fixtures are allowed when they contain no copyrighted game data.
!test/fixtures/**

# Secrets and machine-local settings
.env
.env.*
!.env.example
*.key
*.pem
*.user
*.suo
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
