# Dependencies and generated output
node_modules/
dist/
work/
tmp/
desktop/**/bin/
desktop/**/obj/
*.log

# Downloaded tool payloads. Only the pinned metadata is source-controlled.
.tools/*/
!.tools/manifest.json

# Game-local state, backups, and downloaded translation packages
.game-translate/
backups/
**/*汉化文件*/
**/*漢化文件*/
games/**/game.local.json

